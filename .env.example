INSIGHTMONK_BASE_URL=https://community-api.insightmonk.com
INSIGHTMONK_EMAIL=service-account@example.com
INSIGHTMONK_PASSWORD=replace-me
# Must match community-api so its login JWT can be verified.
JWT_SECRET=replace-with-community-api-jwt-secret

# Same application MySQL database used by community-api.
MYSQL_HOST=database.example.com
MYSQL_PORT=3306
MYSQL_USER=replace-me
MYSQL_PASSWORD=replace-me
MYSQL_DATABASE=replace-me
MYSQL_SSL=1
# Optional CA bundle path when your database provider requires one.
MYSQL_SSL_CA=

MCP_SERVER_URL=http://127.0.0.1:8000/mcp
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
MCP_OAUTH_SIGNING_KEY=replace-with-at-least-32-random-characters
MCP_AUTO_MIGRATE=1
MCP_TRANSPORT=streamable-http

HTTP_TIMEOUT_SECONDS=30
PDF_MAX_DOWNLOAD_BYTES=52428800
PDF_MAX_EMBEDDED_BYTES=20971520
PDF_MAX_EXTRACTED_CHARACTERS=500000
PDF_CACHE_TTL_SECONDS=900
PDF_CACHE_MAX_BYTES=134217728

# STDIO development only. Never set this on a remote deployment.
MCP_DEV_USER_ID=
